# ==============================================================================
# Environment Variables for ISHAAN Enterprises
# Copy to `.env.local` for local development (never commit `.env.local`).
# Add these exact variables in Vercel → Project Settings → Environment Variables.
# ==============================================================================

# --- Supabase (Supabase Dashboard → Project Settings → API) ---
SUPABASE_URL="https://YOUR-PROJECT-ID.supabase.co"
VITE_SUPABASE_URL="https://YOUR-PROJECT-ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
# Server-only secret (NEVER prefix with VITE_) — required so forms can save through RLS:
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY"

# --- Gmail SMTP (Google Account → Security → 2-Step Verification → App Passwords) ---
GMAIL_USER="ishaanenterprises05@gmail.com"
# 16-character Google App Password (spaces are stripped automatically)
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Optional: override where enquiries are delivered (defaults to ishaanenterprises05@gmail.com)
ENQUIRY_TO_EMAIL="ishaanenterprises05@gmail.com"
